<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Resource Card"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Resource title"
                        name="./title"
                        required="{Boolean}true"/>
                    <resourceType
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/select"
                        fieldLabel="Resource type"
                        name="./resourceType"
                        required="{Boolean}true">
                        <items jcr:primaryType="nt:unstructured">
                            <articles
                                jcr:primaryType="nt:unstructured"
                                text="Articles"
                                value="Article"/>
                            <videos
                                jcr:primaryType="nt:unstructured"
                                text="Videos"
                                value="Video"/>
                            <guides
                                jcr:primaryType="nt:unstructured"
                                text="Guides"
                                value="Guide"
                                selected="{Boolean}true"/>
                            <documentation
                                jcr:primaryType="nt:unstructured"
                                text="Documentation"
                                value="Documentation"/>
                        </items>
                    </resourceType>
                    <description
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textarea"
                        fieldLabel="Description"
                        name="./description"
                        required="{Boolean}true"/>
                    <readingTime
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Reading time (e.g. 15 min read)"
                        name="./readingTime"
                        required="{Boolean}true"/>
                    <link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Resource page"
                        fieldDescription="Select an AEM page to make the entire card clickable. The arrow is always visible."
                        name="./link"
                        rootPath="/content"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
