<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0"
    jcr:primaryType="nt:unstructured"
    jcr:title="Learning Path Card"
    sling:resourceType="cq/gui/components/authoring/dialog">
    <content
        jcr:primaryType="nt:unstructured"
        sling:resourceType="granite/ui/components/coral/foundation/fixedcolumns">
        <items jcr:primaryType="nt:unstructured">
            <column
                jcr:primaryType="nt:unstructured"
                sling:resourceType="granite/ui/components/coral/foundation/container">
                <items jcr:primaryType="nt:unstructured">
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Learning path title"
                        name="./title"
                        required="{Boolean}true"/>
                    <image
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="cq/gui/components/authoring/dialog/fileupload"
                        class="cq-droptarget"
                        fieldLabel="Image"
                        fieldDescription="Choose a DAM image, or leave empty to display the grey image placeholder."
                        fileNameParameter="./fileName"
                        fileReferenceParameter="./fileReference"
                        mimeTypes="[image/gif,image/jpeg,image/png,image/webp,image/svg+xml]"
                        name="./file"
                        allowUpload="{Boolean}false"
                        useHTML5="{Boolean}true"/>
                    <alt
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Image alt text"
                        name="./alt"/>
                    <courseCount
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/numberfield"
                        fieldLabel="Number of courses"
                        name="./courseCount"
                        min="1"
                        step="1"
                        required="{Boolean}true"/>
                    <duration
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/textfield"
                        fieldLabel="Total duration (e.g. 20 hours)"
                        name="./duration"
                        required="{Boolean}true"/>
                    <link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="granite/ui/components/coral/foundation/form/pathfield"
                        fieldLabel="Learning path page"
                        fieldDescription="Selecting a page makes the entire card clickable and displays the arrow."
                        name="./link"
                        rootPath="/content"/>
                </items>
            </column>
        </items>
    </content>
</jcr:root>
